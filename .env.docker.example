# Cardly production environment template.
# Copy to a root `.env` on the server and fill in REAL values:
#   cp .env.docker.example .env
# Required: DOMAIN_NAME, JWT_SECRET, ADMIN_EMAIL, ADMIN_PASSWORD.
# Everything else either has a safe default or is optional.

# Server domain (used for FRONTEND_URL / CORS) — e.g. yourdomain.com
DOMAIN_NAME=yourdomain.com

# --- Required ---
# Long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-secret
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# --- Optional (email) ---
EMAIL_ENABLED=true
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=youraccount@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Cardly <noreply@yourdomain.com>

# --- Optional (image storage) ---
STORAGE_TYPE=cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud
CLOUDINARY_API_KEY=your-key
CLOUDINARY_API_SECRET=your-secret

# --- Optional (admin auto-seed at first boot) ---
SEED_ADMIN_ON_START=true

# --- Redis (only if you enable it — currently unused by the app) ---
REDIS_ENABLED=false
REDIS_URL=